# Copy to .env and fill in to activate live data sources.
# .env is git-ignored. Without these keys the app falls back to curated values.

# FRED (rates + inflation). Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Anthropic (the "Do now" AI briefing synthesis). https://console.anthropic.com/
# Without this the app still works; the AI briefing panel is simply disabled.
ANTHROPIC_API_KEY=

# Open-Meteo (weather) needs no key — it's live out of the box.
